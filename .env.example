# Copie para .env e ajuste. Os valores abaixo casam com o docker-compose.yml
# local — em producao o Coolify injeta tudo como secret.

NODE_ENV=development
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://iaphotos:iaphotos@127.0.0.1:55432/iaphotos
REDIS_URL=redis://127.0.0.1:56379

# MinIO local. Em producao: endpoint do bucket, porta 443, SSL ligado.
S3_ENDPOINT=127.0.0.1
S3_PORT=55900
S3_USE_SSL=false
S3_ACCESS_KEY=iaphotos
S3_SECRET_KEY=iaphotos123
S3_BUCKET=ia-photos

# Black Forest Labs — https://api.bfl.ai
BFL_API_KEY=

# Mercado Pago. Use as credenciais de TESTE ate a homologacao passar.
# O webhook secret vem de Suas integracoes > Webhooks > Assinatura secreta.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Painel /admin. Minimo 12 caracteres — o app recusa subir com menos.
ADMIN_PASSWORD=troque-esta-senha-agora

# Retencao LGPD, em dias.
SELFIE_RETENTION_DAYS=7
RESULT_RETENTION_DAYS=30

# Host publico dos assets, usado pelo next/image. Deixe vazio em dev.
NEXT_PUBLIC_ASSET_HOST=

# Video do topo da landing, hospedado no VTurb (ConverteAI). Numa URL de player
# como https://scripts.converteai.net/AAAA/players/PPPP/v4/player.js, o AAAA e o
# ACCOUNT_ID e o PPPP e o PLAYER_ID. Vazio = a landing usa a heroImage
# cadastrada no /admin, e nada quebra.
NEXT_PUBLIC_VTURB_ACCOUNT_ID=
NEXT_PUBLIC_VTURB_PLAYER_ID=

# --- Opcionais: o app funciona sem eles ---

# Brevo (e-mail transacional de entrega e de falha)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

# Meta Conversions API (evento Purchase server-side).
# O PIXEL_ID daqui precisa ser o MESMO do pixel do browser: a dedupe entre os
# dois eventos e por event_id dentro de um pixel so. IDs diferentes = cada venda
# contada duas vezes.
META_PIXEL_ID=
META_CAPI_TOKEN=

# Pixel do browser. OPCIONAL: sem isto vale o ID embutido em MetaPixel.tsx.
# Serve para trocar de conta de anuncio sem deploy — mas e lida em BUILD time,
# entao precisa existir no ambiente que roda o `next build`, nao so no runtime.
NEXT_PUBLIC_FB_PIXEL_ID=
  
# fal.ai — provedor de geração de imagem (Seedream 4.5), escolhido na Fase 0.
FAL_KEY=

# WhatsApp do suporte, so digitos com DDI (ex.: 5541999999999).
# NAO use NEXT_PUBLIC_: isso embutiria o numero no bundle de todo visitante.
# So e enviado ao cliente cujo pedido esta retido (NEEDS_REVIEW). Opcional.
SUPPORT_WHATSAPP=
