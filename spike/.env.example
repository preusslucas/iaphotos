# Black Forest Labs — OPCIONAL. Só para a rota de comparação (a-kontext-multiref-bfl).
# Exige depósito mínimo; deixe vazio até a rota do fal validar a hipótese.
# https://api.bfl.ai  ->  Keys
BFL_API_KEY=

# fal.ai — cobre as rotas A, B, C e D. É a única chave necessária para começar.
# https://fal.ai/dashboard/keys
FAL_KEY=

# LoRA da figura publica, treinada previamente (fal.ai ou Replicate).
# Ex.: https://v3.fal.media/files/.../pytorch_lora_weights.safetensors
FIGURE_LORA_URL=
# Palavra-gatilho usada no treino da LoRA
FIGURE_LORA_TRIGGER=TOK
# Escala da LoRA (0.8-1.2 costuma ser o intervalo util)
FIGURE_LORA_SCALE=1.0
